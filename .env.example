# Notion integration token — https://www.notion.so/my-integrations
# Create an integration → Internal Integration Secret → copy token (starts with ntn_ or secret_)
NOTION_TOKEN=

# Target Notion page ID — open the page in Notion, copy link from Share.
# URL ends with 32 hex chars, e.g. https://www.notion.so/GestureCanvas-Dev-Log-abc123def4567890abcdef12345678
# Paste the 32-character ID (with or without dashes).
NOTION_PAGE_ID=

# Optional: hour (0–23) for nightly sync. Default 23 = 11:00 PM local time.
# SYNC_HOUR=23
